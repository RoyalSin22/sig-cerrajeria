# Copiar este archivo a .env (en la misma carpeta que docker-compose.yml)
# antes de correr: docker compose up -d --build

# Contraseña de PostgreSQL (cambiar del valor por defecto para cualquier uso real)
DB_PASSWORD=change_me_local_dev

# Secreto para firmar los JWT: minimo 32 caracteres, aleatorio.
# Generar uno con, por ejemplo: openssl rand -base64 32
JWT_SECRET=cambia-este-secreto-en-produccion-minimo-32-caracteres

# Origen del frontend, usado por la config de CORS del backend.
# Con el docker-compose.yml tal como esta, el frontend se publica en el 8081.
FRONTEND_ORIGIN=http://localhost:8081

# Origenes extra para usar el sistema desde el celular. Por defecto, la
# direccion HTTPS que da Tailscale (celular.bat). Opcional: solo cambiarlo si
# se publica el sistema por otro medio.
# ORIGENES_CELULAR=https://*.ts.net

# Respaldos automaticos (servicio "backup", ver DEPLOYMENT.md). Opcionales.
# Para tener copia fuera de esta PC, apuntar BACKUP_DIR a una carpeta
# sincronizada con la nube (Google Drive, OneDrive, Dropbox).
# BACKUP_DIR=./backups
# BACKUP_INTERVALO_HORAS=6
# BACKUP_DIAS=30

# Asistente de IA y canal de WhatsApp. Opcionales: sin ellos el resto del
# sistema funciona igual. Ver WHATSAPP_SETUP.md.
# ANTHROPIC_API_KEY=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# Al prender la PC, SIG-Cerrajeria.exe busca una version nueva en GitHub y,
# si la hay, respalda y la instala. Poner "no" para actualizar solo a mano
# (actualizar.bat).
AUTO_ACTUALIZAR=si
